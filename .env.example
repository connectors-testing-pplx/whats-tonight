# ---------------------------------------------------------------------------
# What's Tonight? — environment configuration
#
# Copy this file to `.env.local` and fill in whichever keys you have.
# The app runs perfectly well with NO keys at all: it falls back to the
# packaged seed catalogue. See docs/GETTING-API-KEYS.md for a walkthrough.
#
# IMPORTANT: every key below is SERVER-SIDE ONLY. None of them are prefixed
# with NEXT_PUBLIC_, which means Next.js will never ship them to the browser.
# All provider calls happen inside /src/app/api/* route handlers.
# ---------------------------------------------------------------------------

# --- Metadata + streaming availability -------------------------------------
# TMDB: free. https://www.themoviedb.org  ->  Settings -> API -> request a key.
# Provides posters, genres, runtime, language, release dates, cast, and
# country-specific watch-provider data (Netflix IN, Prime Video IN, JioHotstar).
TMDB_API_KEY=

# --- IMDb rating + vote count, and RT critics score where present -----------
# OMDb: free tier, 1,000 requests/day. https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# --- Which providers to actually use ---------------------------------------
# "seed"  -> use the packaged catalogue only (default, works offline)
# "live"  -> use TMDB/OMDb where keys are present, seed for anything missing
# "auto"  -> live if TMDB_API_KEY is set, otherwise seed
DATA_MODE=auto

# Country + language targeting for availability lookups.
REGION=IN
LOCALE=en-IN

# --- Optional: LLM for review summarisation --------------------------------
# Used ONLY to summarise reception text that has already been retrieved from a
# data provider. Never used to source ratings, availability, or facts.
# Leave blank to use the deterministic non-LLM summariser instead.
ANTHROPIC_API_KEY=
REVIEW_SUMMARY_MODEL=claude-sonnet-4-5

# --- Optional: Firebase (Phase 2 persistence) ------------------------------
# Until these are set the app persists to the browser via the local adapter.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Developer dashboard ---------------------------------------------------
# The /admin route is hidden from the normal UI. Set this to require a token
# in the URL: /admin?key=YOUR_TOKEN . Leave blank to leave /admin open.
ADMIN_TOKEN=
